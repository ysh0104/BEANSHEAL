# BEANSHEAL — 환경변수 예시 (로컬 개발용)
# vercel env pull 로 .env.local 을 받는 것을 권장합니다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 이카운트 Open API
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_KEY=
ECOUNT_ZONE=AC

# Fixie 고정 IP (Vercel Integration 설치 시 자동 설정)
# 형식: http://username:password@velodrome.usefixie.com:80
FIXIE_URL=

# 사무실 PC 프록시 사용 시에만 (Fixie와 동시 사용 X)
# ECOUNT_API_BASE_URL=https://xxxx.trycloudflare.com
# ECOUNT_PROXY_SECRET=

# GitHub Actions 엑셀 봇 (재고현황 자동 동기화)
# GITHUB_TOKEN=   # repo Actions write
# GITHUB_REPO=ysh0104/BEANSHEAL
# ECOUNT_ID=      # 웹 로그인 ID (봇용, GitHub Secrets에도 동일)
# ECOUNT_PW=      # 웹 로그인 PW (GitHub Secrets)
# ECOUNT_STOCK_MENU_DEPTH1=  # (선택) 재고현황 상위 메뉴 selector
# ECOUNT_STOCK_MENU_DEPTH2=  # (선택) 재고현황 하위 메뉴 selector
# → docs/ecount-bot-setup.md
